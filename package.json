{
  "name": "ice3-engine-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "imports": {
    "#test-expect": "./tests/assertions.ts"
  },
  "engines": {
    "node": "^24.0.0 || >=26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -b",
    "typecheck": "tsc -b --pretty false",
    "typecheck:example": "tsc -p examples/m0/tsconfig.json --pretty false && tsc -p examples/m1/tsconfig.json --pretty false",
    "test": "node scripts/run-tests.mjs",
    "test:architecture": "node --test tests/architecture/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run test:architecture && npm run typecheck && npm run typecheck:example && npm test && npm run test:e2e",
    "build:example": "npm run build && webpack --config examples/m0/webpack.config.cjs",
    "dev:example": "npm run build && webpack serve --config examples/m0/webpack.config.cjs",
    "build:example:m1": "npm run build && webpack --config examples/m1/webpack.config.cjs",
    "dev:example:m1": "npm run build && webpack serve --config examples/m1/webpack.config.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "jsdom": "30.1.3",
    "esbuild-loader": "4.5.0",
    "expect": "30.5.2",
    "jest-mock": "30.5.2",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "webpack": "5.112.2",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.1.0"
  }
}
