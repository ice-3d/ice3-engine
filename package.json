{
  "name": "ice3-engine-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "typecheck:example": "tsc -p examples/m0/tsconfig.json --pretty false",
    "test": "node-test run",
    "test:architecture": "node --test tests/architecture/package-boundaries.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run test:architecture && npm run typecheck && npm run typecheck:example && npm test && npm run test:e2e",
    "dev:example": "npm run build && test-tooling --config examples/m0/test-tooling.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "test-tooling": "8.3.5",
    "node-test": "4.1.12"
  }
}
